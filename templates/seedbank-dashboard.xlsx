 </Styles>
 <Worksheet ss:Name="Dashboard"><Table>
  <Column ss:Width="190"/><Column ss:Width="120"/><Column ss:Width="120"/><Column ss:Width="120"/>
  <Row ss:Height="28"><Cell ss:MergeAcross="3" ss:StyleID="Title"><Data ss:Type="String">لوحة تقييم أداء بنوك البذور المجتمعية - بيانات عينة</Data></Cell></Row>
  <Row><Cell ss:StyleID="SubHeader"><Data ss:Type="String">السنة المختارة</Data></Cell><Cell><Data ss:Type="Number">2025</Data></Cell></Row>
  <Row><Cell ss:StyleID="SubHeader"><Data ss:Type="String">عدد البنوك</Data></Cell><Cell ss:Formula="=COUNTA(SeedBanks!R2C1:R8C1)"><Data ss:Type="Number">7</Data></Cell></Row>
  <Row><Cell ss:StyleID="SubHeader"><Data ss:Type="String">إجمالي الإنتاج (كجم)</Data></Cell><Cell ss:Formula="=SUM(Production!R2C3:R8C3)"><Data ss:Type="Number">6400</Data></Cell></Row>
  <Row><Cell ss:StyleID="SubHeader"><Data ss:Type="String">متوسط الإنبات</Data></Cell><Cell ss:StyleID="Percent" ss:Formula="=AVERAGE(Production!R2C6:R8C6)"><Data ss:Type="Number">0.90</Data></Cell></Row>
